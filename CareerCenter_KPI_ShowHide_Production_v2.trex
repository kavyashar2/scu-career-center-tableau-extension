<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="edu.scu.careercenter.kpi.showhide.production.v2" extension-version="0.2.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Shows the selected-subgroup KPI only when a user-facing demographic filter is narrowed.</description>
    <author name="SCU Career Center" email="noreply@example.com" organization="Santa Clara University Career Center" website="https://www.scu.edu"/>
    <min-api-version>1.9</min-api-version>
    <source-location>
      <url>https://kavyashar2.github.io/scu-career-center-tableau-extension/index.html?v=2</url>
    </source-location>
    <icon>

    </icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Career Center KPI Show/Hide</text>
    </resource>
  </resources>
</manifest>
